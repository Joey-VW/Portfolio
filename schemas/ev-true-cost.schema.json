{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joewisto.dev/schemas/ev-true-cost.schema.json",
  "title": "EV True Cost browser data",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "provenanceLevels",
    "sources",
    "vehicles",
    "inputs",
    "charging",
    "presets",
    "plannedTotalCostModel"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "project": {
      "type": "object",
      "required": ["slug", "title", "question", "region", "stage", "updatedAt"],
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "question": { "type": "string" },
        "region": { "type": "string" },
        "stage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date" }
      }
    },
    "provenanceLevels": { "type": "object" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "vehicles": { "type": "object", "required": ["ev", "iceBaseline"] },
    "inputs": { "type": "object" },
    "charging": { "type": "object" },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "plannedTotalCostModel": { "type": "object" }
  }
}
