{
  "name": "joewisto-portfolio-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Repository-wide command surface for the static Joe Wisto portfolio.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "prettier --write package.json .github/*.md .github/*.yml .github/workflows/ci.yml schemas/*.json docs/architecture/*.md docs/decisions/*.md",
    "format:check": "prettier --check package.json .github/*.md .github/*.yml .github/workflows/ci.yml schemas/*.json docs/architecture/*.md docs/decisions/*.md",
    "lint": "uv run --locked --no-sync python tools/check_all.py lint",
    "validate": "uv run --locked --no-sync python tools/check_all.py validate",
    "test": "uv run --locked --no-sync python tools/check_all.py test",
    "check": "npm run format:check && npm run lint && npm run validate && npm run test"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  },
  "packageManager": "npm@11.9.0"
}
